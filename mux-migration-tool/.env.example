# Mux credentials
MUX_TOKEN_ID=your_mux_token_id
MUX_TOKEN_SECRET=your_mux_token_secret
MUX_SIGNING_KEY_ID=your_signing_key_id
MUX_PRIVATE_KEY=your_base64_encoded_private_key
DRM_CONFIGURATION_ID=your_drm_config_id

# Vimeo
VIMEO_ACCESS_TOKEN=your_vimeo_access_token

# Database (SQLite for local use, or PostgreSQL URL)
DATABASE_URL=sqlite:///./migration.db

# Public base URL of this server — used to serve temp SRT/audio files to Mux
# Must be publicly reachable (use ngrok for local dev)
SERVER_BASE_URL=http://your-server-ip:8000

# Optional webhook secret for verifying Mux webhook payloads
MUX_WEBHOOK_SECRET=
